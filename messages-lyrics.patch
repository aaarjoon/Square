+ * The lyrics as a conversation.
+ *
+ * Nothing is shown ahead of the song. Each line arrives as a message bubble
+ * when it is reached, and its words come in one at a time, each the moment
+ * it is sung. Where the source times its words that is exact; where it only
+ * times the line, the words are spread across the line by their length.
+ *
+ * The two sides take turns, but not always one line each: a side often keeps
+ * the floor for two or three lines before the other answers, and a gap in the
+ * song hands the turn over. Which is which is chosen once per song, so it is
+ * the same every time the song is opened.
+ *
+ * A line that names a well-known place gets a map card (see [placeIn]); an
+ * instrumental gap shows the three dots of someone typing.
+ *
+ * Lyrics that are not synced have no "now" to follow, so they are laid out
+ * whole, from the top. A bubble pressed seeks to its line, and the history can
+ * be scrolled back through while the song plays.
+ */
+@Composable
+fun MessagesLyricsView(
+    lyrics: Lyrics,
+    positionMs: State<Long>,
+    modifier: Modifier = Modifier,
+    showTranslation: Boolean = false,
+    onSeek: (Long) -> Unit,
+) {
+    val synced = lyrics.synced
+
+    // Read as a derived value, so only a change of line recomposes the list.
+    val activeLine by remember(lyrics) {
+        derivedStateOf {
+            if (!lyrics.synced) -1
+            else lyrics.lines.indexOfLast { (it.startTimeMs ?: 0L) <= positionMs.value + LEAD_MS }
+        }
+    }
+
+    val chat = remember(lyrics) { chatLayout(lyrics.lines) }
+    val measurer = rememberTextMeasurer()
+
+    // A place gets its card the first time the song sings about it, not on
+    // every mention.
+    val places = remember(lyrics) {
+        val seen = HashSet<String>()
+        Array(lyrics.lines.size) { index ->
+            placeIn(lyrics.lines[index].text)?.takeIf { seen.add(it) }
+        }
+    }
+
+    val last = if (synced) activeLine else lyrics.lines.lastIndex
+
+    // The lines on screen. Synced: those reached so far, newest first, as the
+    // list is laid out from the bottom up like a chat. A blank line shows
+    // only while it is the current one, as the typing dots.
+    val indices = remember(lyrics, last) {
+        val reached = (0..last).filter { index ->
+            lyrics.lines[index].text.isNotBlank() || (synced && index == last)
+        }
+        if (synced) reached.asReversed() else reached
+    }
+
+    val listState = remember(lyrics) { LazyListState() }
+
+    // Back to the newest message when a new one arrives, unless the listener
+    // is reading further up.
+    LaunchedEffect(last) {
+        if (synced && !listState.isScrollInProgress) listState.animateScrollToItem(0)
+    }
+
+    LazyColumn(
+        state = listState,
+        reverseLayout = synced,
+        // The round buttons down the right of the screen sit over the end of
+        // the list, so the end keeps clear of them.
+        contentPadding = PaddingValues(start = 16.dp, end = 64.dp, top = 48.dp, bottom = 48.dp),
+        modifier = modifier
+            .fillMaxSize()
+            .graphicsLayer(compositingStrategy = CompositingStrategy.Offscreen)
+            .drawWithContent {
+                drawContent()
+                drawRect(
+                    brush = Brush.verticalGradient(
+                        0f to Color.Transparent,
+                        0.12f to Color.Black,
+                        0.88f to Color.Black,
+                        1f to Color.Transparent,
+                    ),
+                    blendMode = BlendMode.DstIn,
+                )
+            },
+    ) {
+        items(indices, key = { it }) { index ->
+            val line = lyrics.lines[index]
+            // Sits close to the next bubble when the same side sends that one
+            // too, as a run of messages does.
+            val following = chat.next[index]
+            val grouped = following != -1 &&
+                chat.atEnd[following] == chat.atEnd[index] &&
+                (!synced || following <= last)
+            MessageBubble(
+                line = line,
+                endMs = lyrics.lines.getOrNull(index + 1)?.startTimeMs,
+                atEnd = chat.atEnd[index],
+                grouped = grouped,
+                place = places[index],
+                newest = synced && index == activeLine,
+                age = if (synced) activeLine - index else 0,
+                synced = synced,
+                positionMs = positionMs,
+                measurer = measurer,
+                showTranslation = showTranslation,
+                onClick = { line.startTimeMs?.let(onSeek) },
+            )
+        }
+    }
+}
+
+/** Which side each line is sent from, and which line is sent after it. */
+private class ChatLayout(val atEnd: BooleanArray, val next: IntArray)
+
+/**
+ * Hands out the turns. A side keeps the floor for one line about half the
+ * time, two lines about a third of the time, and three the rest; a gap in the
+ * song always passes it on. The dice are seeded from the song's own lines, so
+ * a song is always cut up the same way.
+ */
+private fun chatLayout(lines: List<LyricLine>): ChatLayout {
+    val random = java.util.Random(lines.size * 31L + (lines.firstOrNull()?.text?.hashCode() ?: 0))
+    val atEnd = BooleanArray(lines.size)
+    val next = IntArray(lines.size) { -1 }
+    var end = true
+    var left = 0
+    var gap = false
+    var previous = -1
+    for (index in lines.indices) {
+        if (lines[index].text.isBlank()) {
+            atEnd[index] = end
+            gap = true
+            continue
+        }
+        if (left <= 0 || gap) {
+            end = !end
+            val roll = random.nextInt(100)
+            left = if (roll < 50) 1 else if (roll < 82) 2 else 3
+        }
+        left--
+        gap = false
+        atEnd[index] = end
+        if (previous >= 0) next[previous] = index
+        previous = index
+    }
+    // A gap in the song shows the typing dots, and the dots belong on the side
+    // the next line is about to come from, not the side of the last one.
+    var upcoming = end
+    for (index in lines.indices.reversed()) {
+        if (lines[index].text.isBlank()) atEnd[index] = upcoming else upcoming = atEnd[index]
+    }
+    return ChatLayout(atEnd, next)
+}
+
+/** When each word of a line is sung and stops being sung, and where it sits in the line's text. */
+internal class Reveal(val starts: LongArray, val ends: LongArray, val ranges: List<IntRange>)
+
+/**
+ * The words of [line] with the moment each is sung: the source's own timing
+ * where it has it, otherwise the line's time shared out by word length, over
+ * the first four fifths of the time before the next line.
+ */
+internal fun revealOf(line: LyricLine, endMs: Long?): Reveal {
+    val found = wordRanges(line)
+    if (line.words.isNotEmpty() && found.none { it == null }) {
+        return Reveal(
+            LongArray(line.words.size) { line.words[it].startMs },
+            LongArray(line.words.size) { line.words[it].endMs },
+            found.map { it!! },
+        )
+    }
+    val spans = Regex("\\S+").findAll(line.text).map { it.range }.toList()
+    val start = line.startTimeMs ?: 0L
+    val room = ((endMs ?: (start + 4000L)) - start).coerceIn(600L, 6000L)
+    val singing = room * 4 / 5
+    val total = spans.sumOf { it.last - it.first + 2 }.coerceAtLeast(1)
+    var used = 0
+    val starts = LongArray(spans.size) { i ->
+        val at = start + singing * used / total
+        used += spans[i].last - spans[i].first + 2
+        at
+    }
+    // A word lasts until the next one starts; the last one to the end of the song's share.
+    val ends = LongArray(spans.size) { i ->
+        if (i < spans.lastIndex) starts[i + 1] else start + singing
+    }
+    return Reveal(starts, ends, spans)
+}
+
+/** How long a word's whole pop lasts, from the moment it is sung. */
+private const val POP_TOTAL_MS = WORD_HOLD_MS + WORD_SETTLE_MS
+
+/** Overshoots a little on the way to 1, like a spring. */
+private fun backOut(x: Float): Float {
+    val c = x.coerceIn(0f, 1f) - 1f
+    return 1f + 2.70158f * c * c * c + 1.70158f * c * c
+}
+
+/**
+ * What is needed to draw the words of one line: the box each word occupies in
+ * the line, found once, and each word measured on its own the first time it
+ * is drawn, regular or bold, and kept. Measuring as the words come, rather
+ * than all of them when the line starts, keeps the start of a line from
+ * stalling a frame. Nothing here changes while the song moves on, so a frame
+ * costs a few draw calls and no text layout.
+ */
+private class LineDrawing {
+    var layout: TextLayoutResult? = null
+    var boxes: List<Rect> = emptyList()
+    private var words: List<AnnotatedString> = emptyList()
+    private var regular: Array<TextLayoutResult?> = emptyArray()
+    private var heavy: Array<TextLayoutResult?> = emptyArray()
+    private var style: TextStyle = TextStyle.Default
+    private var boldStyle: TextStyle = TextStyle.Default
+
+    fun build(layout: TextLayoutResult, line: LyricLine, reveal: Reveal, style: TextStyle) {
+        val wordTexts = ArrayList<AnnotatedString>(reveal.ranges.size)
+        val wordBoxes = ArrayList<Rect>(reveal.ranges.size)
+        for (range in reveal.ranges) {
+            val fits = range.first >= 0 &&
+                range.last < line.text.length &&
+                range.last < layout.layoutInput.text.length
+            wordTexts.add(
+                if (fits) {
+                    AnnotatedString(line.text.substring(range.first, range.last + 1))
+                } else {
+                    AnnotatedString("")
+                },
+            )
+            val first = if (fits) layout.getBoundingBox(range.first) else Rect.Zero
+            val end = if (fits) layout.getBoundingBox(range.last) else Rect.Zero
+            wordBoxes.add(Rect(first.left, first.top, end.right, first.bottom))
+        }
+        words = wordTexts
+        boxes = wordBoxes
+        regular = arrayOfNulls(wordTexts.size)
+        heavy = arrayOfNulls(wordTexts.size)
+        this.style = style
+        this.boldStyle = style.copy(fontWeight = FontWeight.Bold)
+        this.layout = layout
+    }
+
+    fun regularAt(i: Int, measurer: TextMeasurer): TextLayoutResult =
+        regular[i] ?: measurer.measure(words[i], style).also { regular[i] = it }
+
+    fun boldAt(i: Int, measurer: TextMeasurer): TextLayoutResult =
+        heavy[i] ?: measurer.measure(words[i], boldStyle).also { heavy[i] = it }
+}
+
+/**
+ * Draws the line word by word as it is sung. A word not yet sung is not
+ * drawn. A word just sung fades in bold and a little bigger, springing up
+ * past that size, and holds it for an instant; then it eases back to the
+ * size and weight of the rest, a third of a second after it came. It is
+ * scaled about its own centre as a drawing, so it grows over its neighbours
+ * and pushes none. Called from the draw phase, so a moving song redraws this
+ * and nothing else.
+ */
+private fun DrawScope.drawSungWords(
+    drawing: LineDrawing,
+    reveal: Reveal,
+    positionMs: Long,
+    color: Color,
+    measurer: TextMeasurer,
+) {
+    for (i in reveal.starts.indices) {
+        val t = (positionMs - reveal.starts[i]).toFloat()
+        if (t < 0f) continue
+        val box = drawing.boxes[i]
+        if (t >= POP_TOTAL_MS) {
+            drawText(drawing.regularAt(i, measurer), color = color, topLeft = Offset(box.left, box.top))
+            continue
+        }
+
+        // Up with a spring, held, then eased back down.
+        val settle = ((t - WORD_HOLD_MS) / WORD_SETTLE_MS).coerceIn(0f, 1f)
+        val ease = settle * settle * (3f - 2f * settle)
+        val grow = 1f + POP * (if (t < 120f) backOut(t / 120f) else 1f) * (1f - ease)
+        val fade = (t / WORD_FADE_MS).coerceIn(0f, 1f)
+        val centre = box.center
+
+        withTransform({ scale(grow, grow, centre) }) {
+            // Bold gives way to regular as it settles, so the weight does not jump.
+            val bold = drawing.boldAt(i, measurer)
+            drawText(
+                bold,
+                color = color.copy(alpha = color.alpha * fade * (1f - ease)),
+                topLeft = Offset(centre.x - bold.size.width / 2f, centre.y - bold.size.height / 2f),
+            )
+            if (ease > 0f) {
+                val plain = drawing.regularAt(i, measurer)
+                drawText(
+                    plain,
+                    color = color.copy(alpha = color.alpha * ease),
+                    topLeft = Offset(centre.x - plain.size.width / 2f, centre.y - plain.size.height / 2f),
+                )
+            }
+        }
+    }
+}
+
+/**
+ * A clock for animating words that runs on the screen's own frames.
+ *
+ * The song's position is only reported every so often, and an animation
+ * driven straight from it moves in steps of that size however fast the screen
+ * refreshes. This one carries on from the last report frame by frame, so the
+ * words move smoothly, and follows the reports so it never drifts: a report
+ * well away from where it expected (a seek) is taken as it is. It runs on for
+ * only a third of a second after a report, so a paused song, which reports
+ * nothing, stops asking the screen for frames.
+ */
+@Composable
+internal fun rememberFrameClock(positionMs: State<Long>, running: Boolean): State<Long> {
+    // Starts empty and is filled from the effect below: reading the position
+    // here, while composing, would recompose the caller on every report.
+    val smooth = remember { mutableStateOf(0L) }
+    LaunchedEffect(running) {
+        if (!running) return@LaunchedEffect
+        var anchor = positionMs.value
+        var anchorAt = System.nanoTime()
+        smooth.value = anchor
+        snapshotFlow { positionMs.value }.collectLatest { reported ->
+            val now = System.nanoTime()
+            val expected = anchor + (now - anchorAt) / 1_000_000L
+            anchor = reported
+            anchorAt = now
+            if (abs(reported - expected) > 600L) smooth.value = reported
+            val until = now + 350_000_000L
+            while (true) {
+                val frame = withFrameNanos { System.nanoTime() }
+                if (frame > until) break
+                val ahead = ((frame - anchorAt) / 1_000_000L).coerceAtMost(300L)
+                smooth.value = maxOf(smooth.value, anchor + ahead)
+            }
+        }
+    }
+    return smooth
+}
+
+@Composable
+private fun MessageBubble(
+    line: LyricLine,
+    endMs: Long?,
+    atEnd: Boolean,
+    grouped: Boolean,
+    place: String?,
+    newest: Boolean,
+    age: Int,
+    synced: Boolean,
+    positionMs: State<Long>,
+    measurer: TextMeasurer,
+    showTranslation: Boolean,
+    onClick: () -> Unit,
+) {
+    val rtl = LocalLayoutDirection.current == LayoutDirection.Rtl
+
+    // Pops in once, when it is the line just reached. A bubble that comes
+    // into view by scrolling, or after a seek, is simply there.
+    val pop = remember { Animatable(if (newest) 0f else 1f) }
+    LaunchedEffect(Unit) {
+        if (pop.value < 1f) {
+            pop.animateTo(1f, spring(dampingRatio = 0.6f, stiffness = Spring.StiffnessMedium))
+        }
+    }
+
+    // The line being sung in full, the one before it a little quieter, and
+    // the older ones quieter still. Without sync every line is the same.
+    val dim by animateFloatAsState(
+        targetValue = when {
+            !synced || age <= 0 -> 1f
+            age == 1 -> 0.62f
+            else -> 0.42f
+        },
+        animationSpec = tween(180),
+        label = "messageDim",
+    )
+    // A thin outline on the line being sung.
+    val ring by animateFloatAsState(
+        targetValue = if (newest) 1f else 0f,
+        animationSpec = tween(150),
+        label = "messageRing",
+    )
+
+    val ink = GlassInk
+    val sung = if (atEnd) Color.White else ink
+    val fill = if (atEnd) SentBlue else ink.copy(alpha = 0.16f)
+
+    val round = 20.dp
+    val corner = 5.dp
+    val card = place != null && line.text.isNotBlank()
+    val shape = when {
+        card -> RoundedCornerShape(18.dp)
+        // Only the last of a run has the tail; the ones before it are round.
+        grouped -> RoundedCornerShape(round)
+        else -> RoundedCornerShape(
+            topStart = round,
+            topEnd = round,
+            bottomStart = if (atEnd) round else corner,
+            bottomEnd = if (atEnd) corner else round,
+        )
+    }
+
+    Row(
+        Modifier
+            .fillMaxWidth()
+            .padding(bottom = if (grouped) 2.dp else 8.dp),
+        horizontalArrangement = if (atEnd) Arrangement.End else Arrangement.Start,
+    ) {
+        Column(
+            Modifier
+                .then(if (card) Modifier.width(264.dp) else Modifier.widthIn(max = 300.dp))
+                .graphicsLayer {
+                    val p = pop.value
+                    alpha = p.coerceIn(0f, 1f) * dim
+                    val scale = 0.7f + 0.3f * p
+                    scaleX = scale
+                    scaleY = scale
+                    // Rises into place from below, and bounces past it.
+                    translationY = (1f - p) * 24.dp.toPx()
+                    // Grows out of the corner its tail is on.
+                    transformOrigin = TransformOrigin(if (atEnd != rtl) 1f else 0f, 1f)
+                }
+                .clip(shape)
+                .background(fill)
+                .border(1.dp, sung.copy(alpha = 0.4f * ring), shape)
+                .clickable(enabled = line.startTimeMs != null, onClick = onClick),
+        ) {
+            if (card) MapHeader(place!!)
+            Column(Modifier.padding(horizontal = 14.dp, vertical = 9.dp)) {
+                if (line.text.isBlank()) {
+                    TypingDots(sung)
+                } else {
+                    // Only the line being sung reads the position, so only it
+                    // redraws as the song moves.
+                    val timed = synced && newest
+                    // Only the line being sung needs its words timed.
+                    val reveal = remember(line, endMs, timed) {
+                        if (timed) revealOf(line, endMs) else null
+                    }
+                    val drawing = remember { LineDrawing() }
+                    val clock = rememberFrameClock(positionMs, timed)
+                    // Where the words of the line ended up. Not state: nothing
+                    // should recompose when it is set.
+                    val layoutHolder = remember { arrayOfNulls<TextLayoutResult>(1) }
+                    val textStyle = MaterialTheme.typography.bodyLarge.copy(
+                        fontSize = 18.sp,
+                        lineHeight = 24.sp,
+                        fontWeight = FontWeight.Medium,
+                    )
+                    // While the line is being sung this text is invisible: it
+                    // only gives the bubble its size and the words their
+                    // places. The words are drawn over it, one by one, as
+                    // they are sung (see drawSungWords).
+                    Text(
+                        line.text,
+                        style = textStyle,
+                        color = if (timed) Color.Transparent else sung,
+                        onTextLayout = { layoutHolder[0] = it },
+                        modifier = if (reveal != null) {
+                            Modifier.drawWithContent {
+                                drawContent()
+                                val layout = layoutHolder[0]
+                                if (layout != null) {
+                                    if (drawing.layout !== layout) {
+                                        drawing.build(layout, line, reveal, textStyle)
+                                    }
+                                    drawSungWords(drawing, reveal, clock.value, sung, measurer)
+                                }
+                            }
+                        } else {
+                            Modifier
+                        },
+                    )
+                    if (card) {
+                        Row(
+                            verticalAlignment = Alignment.CenterVertically,
+                            modifier = Modifier.padding(top = 4.dp),
+                        ) {
+                            Box(
+                                Modifier
+                                    .size(9.dp)
+                                    .background(Color(0xFFEA4335), CircleShape),
+                            )
+                            Text(
+                                place!!,
+                                style = MaterialTheme.typography.bodySmall.copy(fontSize = 12.sp),
+                                color = sung.copy(alpha = 0.75f),
+                                modifier = Modifier.padding(start = 6.dp),
+                            )
+                        }
+                    }
+                    val translation = line.translation.takeIf { showTranslation && !it.isNullOrBlank() }
+                    if (translation != null) {
+                        Text(
+                            translation,
+                            style = MaterialTheme.typography.bodyMedium,
+                            color = sung.copy(alpha = 0.7f),
+                            modifier = Modifier.padding(top = 3.dp),
+                        )
+                    }
+                }
+            }
+        }
+    }
+}
+
+/**
+ * The picture at the top of a map card: a little drawn map, a different one
+ * for each place, with a pin on it. Nothing is downloaded.
+ */
+@Composable
+private fun MapHeader(place: String) {
+    val seed = place.hashCode()
+    // Moves the pin and the roads about a little, so two places do not look
+    // like the same map.
+    val shift = ((seed and 0x7fffffff) % 40) / 100f
+    Box(
+        Modifier
+            .fillMaxWidth()
+            .height(72.dp),
+    ) {
+        Canvas(Modifier.fillMaxSize()) {
+            val w = size.width
+            val h = size.height
+            drawRect(Color(0xFFE9E5DA))
+            drawRect(
+                Color(0xFFCFE3C2),
+                topLeft = Offset(w * (0.50f + shift / 2f), h * 0.08f),
+                size = Size(w * 0.30f, h * 0.42f),
+            )
+            drawRect(
+                Color(0xFFBFD9EA),
+                topLeft = Offset(0f, h * 0.76f),
+                size = Size(w, h * 0.24f),
+            )
+            val road = Color.White
+            drawLine(road, Offset(0f, h * (0.30f + shift / 2f)), Offset(w, h * 0.18f), strokeWidth = 9f)
+            drawLine(road, Offset(w * (0.20f + shift / 2f), 0f), Offset(w * 0.42f, h), strokeWidth = 7f)
+            drawLine(road, Offset(w * 0.78f, 0f), Offset(w * (0.66f + shift / 3f), h * 0.76f), strokeWidth = 5f)
+            val pin = Offset(w * (0.30f + shift), h * 0.46f)
+            drawCircle(Color(0xFFEA4335), radius = h * 0.13f, center = pin)
+            drawCircle(Color.White, radius = h * 0.05f, center = pin)
+        }
+        Text(
+            "Maps",
+            color = Color.White,
+            style = MaterialTheme.typography.labelSmall.copy(fontSize = 10.sp),
+            modifier = Modifier
+                .padding(8.dp)
+                .background(Color.Black.copy(alpha = 0.35f), RoundedCornerShape(6.dp))
+                .padding(horizontal = 6.dp, vertical = 2.dp),
+        )
+    }
+}
+
+/** The three dots of someone typing, for a gap in the song. */
+@Composable
+private fun TypingDots(color: Color) {
+    val transition = rememberInfiniteTransition(label = "typing")
+    Row(
+        horizontalArrangement = Arrangement.spacedBy(5.dp),
+        modifier = Modifier.padding(vertical = 6.dp),
+    ) {
+        repeat(3) { dot ->
+            val level by transition.animateFloat(
+                initialValue = 0.3f,
+                targetValue = 1f,
+                animationSpec = infiniteRepeatable(
+                    animation = tween(480, delayMillis = dot * 160, easing = LinearEasing),
+                    repeatMode = RepeatMode.Reverse,
+                ),
+                label = "typingDot$dot",
+            )
+            Box(
+                Modifier
+                    .size(8.dp)
+                    .graphicsLayer { alpha = level }
+                    .background(color, CircleShape),
+            )
+        }
+    }
+}
