+private val GlyphPaths = HashMap<String, Path>()
+
+private fun glyph(d: String, evenOdd: Boolean = false): Path =
+    GlyphPaths.getOrPut(d) {
+        PathParser().parsePathString(d).toPath().also {
+            if (evenOdd) it.fillType = PathFillType.EvenOdd
+        }
+    }
+
+private val StarPath: Path by lazy {
+    Path().apply {
+        for (i in 0 until 10) {
+            val angle = (-90.0 + i * 36.0) * PI / 180.0
+            val radius = if (i % 2 == 0) 10.0 else 4.5
+            val x = (12.0 + radius * cos(angle)).toFloat()
+            val y = (12.8 + radius * sin(angle)).toFloat()
+            if (i == 0) moveTo(x, y) else lineTo(x, y)
+        }
+        close()
+    }
+}
