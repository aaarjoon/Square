+/** The blue of a sent message. */
+private val SentBlue = Color(0xFF0A84FF)
+
+/** How long a word takes to fade in once it is sung. */
+private const val WORD_FADE_MS = 90f
+
+/** How long a word stays at its biggest, bold, before it starts to ease back. */
+private const val WORD_HOLD_MS = 110f
+
+/** How long it then takes to ease back to the size and weight of the rest. */
+private const val WORD_SETTLE_MS = 220f
