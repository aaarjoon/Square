+/** Longest names first, so "Brooklyn Bridge" is found before "Brooklyn". */
+private val placeMatchers: List<Pair<Regex, String>> by lazy {
+    placeList
+        .sortedByDescending { it.first.length }
+        .map { (key, name) ->
+            Regex("(?<![a-z])" + Regex.escape(key) + "(?![a-z])") to name
+        }
+}
+
+/** The "Name, Region" of the first well-known place the [line] sings about, or null. */
+internal fun placeIn(line: String): String? {
+    val text = line.lowercase()
+    for ((matcher, name) in placeMatchers) {
+        if (matcher.containsMatchIn(text)) return name
+    }
+    return null
+}
