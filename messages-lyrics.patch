+    "statue of liberty" to "Statue of Liberty, New York",
+    "empire state building" to "Empire State Building, New York",
+    "wall street" to "Wall Street, New York",
+    "coney island" to "Coney Island, New York",
+    "yankee stadium" to "Yankee Stadium, New York",
+    "brooklyn" to "Brooklyn, New York",
+    "manhattan" to "Manhattan, New York",
+    "harlem" to "Harlem, New York",
+    "the bronx" to "The Bronx, New York",
+    "new york" to "New York, USA",
+    "nyc" to "New York, USA",
+    // California
+    "hollywood" to "Hollywood, Los Angeles",
+    "beverly hills" to "Beverly Hills, California",
+    "rodeo drive" to "Rodeo Drive, Beverly Hills",
+    "sunset boulevard" to "Sunset Boulevard, Los Angeles",
+    "sunset strip" to "Sunset Strip, Los Angeles",
+    "santa monica" to "Santa Monica, California",
