+/** The mood of a line: the one whose words it has most of, else the music note. */
+private fun moodOf(text: String): Mood {
+    val words = text.lowercase()
+        .split(Regex("[^a-z']+"))
+        .map { it.trim('\'') }
+        .filter { it.isNotEmpty() }
+    var best = Mood.MUSIC
+    var bestCount = 0
+    for (mood in Mood.entries) {
+        val count = words.count { it in mood.words }
+        if (count > bestCount) {
+            best = mood
+            bestCount = count
+        }
+    }
+    return best
+}
