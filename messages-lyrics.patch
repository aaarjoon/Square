+
+/** The glow and heart of the word being sung. */
+private val StarOrange = Color(0xFFFF5A1F)
+
+/** The warm white of the word being sung. */
+private val StarPeach = Color(0xFFFFD9C4)
+
+/** How long the lines to a new star take to reach it. */
+private const val LINK_MS = 260f
+
+/** How long the old phrase takes to go out as the next one starts. */
+private const val HAND_OVER_MS = 450f
+
+/** How long a phrase stays up after its last word before it fades out on its own. */
+private const val LINGER_MS = 1600L
+
+/** How long that fade takes. */
+private const val LINGER_FADE_MS = 500f
+
+/** How long a word takes to shrink to a label once the next word is sung. */
+private const val SHRINK_MS = 350f
+
+/** A label's size once shrunk, against the size of the word being sung. */
+private const val LABEL_SCALE = 0.37f
+
+/** A four-pointed sparkle of radius 1, centred on the origin. */
+private val SparkPath = Path().apply {
+    moveTo(0f, -1f)
+    lineTo(0.2f, -0.2f)
+    lineTo(1f, 0f)
+    lineTo(0.2f, 0.2f)
+    lineTo(0f, 1f)
+    lineTo(-0.2f, 0.2f)
+    lineTo(-1f, 0f)
+    lineTo(-0.2f, -0.2f)
+    close()
+}
+
+/**
+ * The lyrics as a constellation.
+ *
+ * A line is a phrase, and a phrase is a small piece of sky: each word, as it is
+ * sung, lights a star somewhere on the screen and is joined to the one before
+ * by a thin line that draws itself across. The word being sung is large and
+ * warm, with an orange star and a glow; the moment the next word comes it
+ * shrinks to a small label beside its star and stays there, and the phrase
+ * builds up until the next line starts, when it fades and a new sky begins.
+ *
+ * Where the stars sit is chosen once for each line from the line itself, so a
+ * song is laid out the same way every time it is played.
+ *
+ * It reads best wide, but it never turns the phone: it draws into whatever
+ * space it is given, so the other lyric styles stay a tap away in any
+ * orientation. Lyrics that are not synced have no "now" for a sky to follow,
+ * so they are shown plainly, as in the classic view.
+ */
+@Composable
+fun ConstellationLyricsView(
+    lyrics: Lyrics,
+    positionMs: State<Long>,
+    modifier: Modifier = Modifier,
+    showTranslation: Boolean = false,
+    onSeek: (Long) -> Unit,
+) {
+    if (!lyrics.synced) {
+        ClassicLyricsView(
+            lyrics = lyrics,
+            positionMs = positionMs,
+            modifier = modifier,
+            showTranslation = showTranslation,
+            onSeek = onSeek,
+        )
+    } else {
+        ConstellationSky(lyrics, positionMs, modifier)
+    }
+}
+
+@Composable
+private fun ConstellationSky(
+    lyrics: Lyrics,
+    positionMs: State<Long>,
+    modifier: Modifier,
+) {
+    val ink = GlassInk
+    val measurer = rememberTextMeasurer()
+    val clock = rememberFrameClock(positionMs, true)
+    val bigStyle = MaterialTheme.typography.headlineSmall.copy(
+        fontSize = 30.sp,
+        fontWeight = FontWeight.Bold,
+    )
+    val lines = lyrics.lines
+    val starts = remember(lyrics) { LongArray(lines.size) { lines[it].startTimeMs ?: 0L } }
+    // Built the first time a line is needed, then kept.
+    val phrases = remember(lyrics) { arrayOfNulls<Phrase>(lines.size) }
+
+    Canvas(modifier.fillMaxSize()) {
+        val pos = clock.value
+
+        // The phrase being sung: the latest line that has started and has
+        // words. A gap in the song leaves the last phrase up until it fades.
+        var current = -1
+        for (i in lines.indices.reversed()) {
+            if (starts[i] <= pos && lines[i].text.isNotBlank()) {
+                current = i
+                break
+            }
+        }
+        if (current < 0) return@Canvas
+        var before = -1
+        for (i in current - 1 downTo 0) {
+            if (lines[i].text.isNotBlank()) {
+                before = i
+                break
+            }
+        }
+
+        // The round buttons down the right of the screen keep to their own
+        // strip, so the sky leaves it free.
+        val area = Rect(
+            left = 28.dp.toPx(),
+            top = 20.dp.toPx(),
+            right = size.width - 64.dp.toPx(),
+            bottom = size.height - 20.dp.toPx(),
+        )
+
+        val sinceStart = pos - starts[current]
+        val handOver = (sinceStart / HAND_OVER_MS).coerceIn(0f, 1f)
+
+        if (before >= 0 && handOver < 1f) {
+            drawPhrase(
+                phraseFor(phrases, lines, before), pos, 1f - handOver,
+                area, ink, measurer, bigStyle,
+            )
+        }
+        drawPhrase(
+            phraseFor(phrases, lines, current), pos, 1f,
+            area, ink, measurer, bigStyle,
+        )
+    }
+}
+
+/** One line of the song as a piece of sky: when its words come, and where its stars are. */
+private class Phrase(
+    val line: LyricLine,
+    val reveal: Reveal,
+    /** Where each star sits, as a fraction of the sky, across and down. */
+    val xs: FloatArray,
+    val ys: FloatArray,
+    /** For a star, an earlier one it is also joined to, or -1. */
+    val extra: IntArray,
+) {
+    /** Each word, measured at the size of the word being sung, when it is first needed. */
+    val labels = arrayOfNulls<TextLayoutResult>(xs.size)
+}
+
+private fun phraseFor(cache: Array<Phrase?>, lines: List<LyricLine>, index: Int): Phrase {
+    cache[index]?.let { return it }
+    val line = lines[index]
+    val reveal = revealOf(line, lines.getOrNull(index + 1)?.startTimeMs)
+    val count = reveal.starts.size
+    val random = java.util.Random(index * 7919L + line.text.hashCode())
+
+    val xs = FloatArray(count)
+    val ys = FloatArray(count)
+    var x = 0.12f + random.nextFloat() * 0.25f
+    var y = 0.25f + random.nextFloat() * 0.5f
+    var direction = 1f
+    for (i in 0 until count) {
+        var nx = x
+        var ny = y
+        var tries = 0
+        do {
+            if (i > 0) {
+                nx = x + direction * (0.10f + random.nextFloat() * 0.14f)
+                ny = y + (random.nextFloat() - 0.5f) * 0.6f
+                // Turns back at the edge, so a long line zigzags across the sky.
+                if (nx > 0.92f || nx < 0.08f) {
+                    direction = -direction
+                    nx = x + direction * (0.10f + random.nextFloat() * 0.14f)
+                }
+            }
+            nx = nx.coerceIn(0.08f, 0.92f)
+            ny = ny.coerceIn(0.14f, 0.86f)
+            tries++
+        } while (tries < 12 && (0 until i).any { j ->
+                // The sky is wider than it is tall, so a step across counts for less.
+                val dx = (xs[j] - nx) * 1.8f
+                val dy = ys[j] - ny
+                sqrt(dx * dx + dy * dy) < 0.16f
+            })
+        xs[i] = nx
+        ys[i] = ny
+        x = nx
+        y = ny
+    }
+    // Now and then a star is joined back to an earlier one too, so the lines
+    // make a web and not just a path.
+    val extra = IntArray(count) { i ->
+        if (i >= 3 && random.nextInt(100) < 35) random.nextInt(i - 1) else -1
+    }
+    return Phrase(line, reveal, xs, ys, extra).also { cache[index] = it }
+}
+
+private fun mix(from: Float, to: Float, fraction: Float): Float = from + (to - from) * fraction
+
+/** Overshoots a little on the way to 1, like a spring. */
+private fun backOut(fraction: Float): Float {
+    val c = fraction.coerceIn(0f, 1f) - 1f
+    return 1f + 2.70158f * c * c * c + 1.70158f * c * c
+}
+
+private fun smooth(fraction: Float): Float {
+    val x = fraction.coerceIn(0f, 1f)
+    return x * x * (3f - 2f * x)
+}
+
+private fun clampTo(value: Float, low: Float, high: Float): Float =
+    if (low > high) (low + high) / 2f else value.coerceIn(low, high)
+
+private fun DrawScope.drawPhrase(
+    phrase: Phrase,
+    pos: Long,
+    fade: Float,
+    area: Rect,
+    ink: Color,
+    measurer: TextMeasurer,
+    bigStyle: TextStyle,
+) {
+    val reveal = phrase.reveal
+    val count = reveal.starts.size
+    if (count == 0) return
+
+    // The word being sung: the last one that has started.
+    var current = -1
+    for (i in 0 until count) if (reveal.starts[i] <= pos) current = i
+    if (current < 0) return
+
+    // A phrase left standing after its last word goes out on its own.
+    val lingerEnd = reveal.ends[count - 1] + LINGER_MS
+    val alpha = fade * (1f - (pos - lingerEnd) / LINGER_FADE_MS).coerceIn(0f, 1f)
+    if (alpha <= 0f) return
+
+    val dp = 1.dp.toPx()
+    val width = area.width
+    val height = area.height
+    fun starX(i: Int) = area.left + phrase.xs[i] * width
+    fun starY(i: Int) = area.top + phrase.ys[i] * height
+
+    // The lines first, so the stars and words sit over them.
+    val lineColor = ink.copy(alpha = 0.32f * alpha)
+    for (i in 1..current) {
+        val reach = ((pos - reveal.starts[i]) / LINK_MS).coerceIn(0f, 1f)
+        val from = Offset(starX(i - 1), starY(i - 1))
+        val to = Offset(starX(i), starY(i))
+        drawLine(
+            lineColor, from,
+            Offset(mix(from.x, to.x, reach), mix(from.y, to.y, reach)),
+            strokeWidth = dp,
+        )
+        val back = phrase.extra[i]
+        if (back >= 0) {
+            val other = Offset(starX(back), starY(back))
+            drawLine(
+                lineColor.copy(alpha = 0.18f * alpha), to,
+                Offset(mix(to.x, other.x, reach), mix(to.y, other.y, reach)),
+                strokeWidth = dp,
+            )
+        }
+    }
+
+    for (i in 0..current) {
+        val sung = pos - reveal.starts[i]
+        val centre = Offset(starX(i), starY(i))
+        val isCurrent = i == current
+
+        // The star: it pops in, and the one being sung breathes.
+        val appear = backOut(sung / 220f)
+        val breathe = if (isCurrent) 1f + 0.1f * sin(pos / 170f) else 1f
+        val radius = (if (isCurrent) 7.dp.toPx() else 4.dp.toPx()) * appear * breathe
+        if (isCurrent) {
+            val glow = 20.dp.toPx() * appear
+            // A gradient needs a radius above zero, and the pop starts from
+            // exactly zero on the first frame of every word.
+            if (glow > 0.5f) drawCircle(
+                brush = Brush.radialGradient(
+                    listOf(StarOrange.copy(alpha = 0.55f * alpha), Color.Transparent),
+                    center = centre,
+                    radius = glow,
+                ),
+                radius = glow,
+                center = centre,
+            )
+        }
+        val starColor = if (isCurrent) StarOrange else ink.copy(alpha = 0.8f)
+        withTransform({
+            translate(centre.x, centre.y)
+            scale(radius, radius, Offset.Zero)
+        }) {
+            drawPath(SparkPath, starColor.copy(alpha = starColor.alpha * alpha))
+        }
+
+        // The word: large and warm while it is sung, a small label after.
+        val range = phrase.reveal.ranges[i]
+        val line = phrase.line
+        if (range.last >= line.text.length) continue
+        val layout = phrase.labels[i] ?: measurer.measure(
+            line.text.substring(range.first, range.last + 1),
+            bigStyle,
+        ).also { phrase.labels[i] = it }
+        val w = layout.size.width.toFloat()
+        val h = layout.size.height.toFloat()
+
+        // How far it has shrunk: not at all while it is the word being sung.
+        val shrunk = if (isCurrent) 0f else smooth((pos - reveal.starts[i + 1]) / SHRINK_MS)
+        val scale = if (isCurrent) 0.55f + 0.45f * backOut(sung / 200f) else mix(1f, LABEL_SCALE, shrunk)
+
+        // Beside its star, on whichever side has the room; as a label, below
+        // and to the right of it.
+        val bigSide = if (phrase.xs[i] > 0.6f) -1f else 1f
+        val bigCx = centre.x + bigSide * (w / 2f + 16.dp.toPx())
+        val bigCy = centre.y
+        val smallCx = centre.x + w * LABEL_SCALE / 2f + 7.dp.toPx()
+        val smallCy = centre.y + 9.dp.toPx()
+        var cx = mix(bigCx, smallCx, shrunk)
+        var cy = mix(bigCy, smallCy, shrunk)
+        cx = clampTo(cx, area.left + w * scale / 2f, area.right - w * scale / 2f)
+        cy = clampTo(cy, area.top + h * scale / 2f, area.bottom - h * scale / 2f)
+
+        val big = lerp(ink, StarPeach, 0.55f)
+        val small = ink.copy(alpha = 0.55f)
+        val wordColor = lerp(big, small, shrunk)
+        val appearAlpha = (sung / 140f).coerceIn(0f, 1f)
+        val labelCentre = Offset(cx, cy)
+        withTransform({ scale(scale, scale, labelCentre) }) {
+            drawText(
+                layout,
+                color = wordColor.copy(alpha = wordColor.alpha * alpha * appearAlpha),
+                topLeft = Offset(cx - w / 2f, cy - h / 2f),
+            )
+        }
+    }
+}
